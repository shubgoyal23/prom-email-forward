PORT=3000
EMAIL_WORKER_URL=https://email-worker.example.com
EMAIL_WORKER_KEY=ew_xxxxxxxxxxxxxxxx
ADMIN_EMAILS=admin@example.com,oncall@example.com
# Optional: must be an SES-verified sender
EMAIL_FROM=Alerts <alerts@yourdomain.com>
# Optional: shared secret Alertmanager sends as a Bearer token
WEBHOOK_TOKEN=change-me
# Host port docker compose publishes (container always listens on 3000)
HOST_PORT=3000
# Optional: timezone for times shown in emails (default UTC)
ALERT_TIMEZONE=UTC
